DATABASE_URL="postgresql://restaurant_admin:restaurant_admin@localhost:5433/restaurant_admin?schema=public"

JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="1d"
PORT=3100

# Local email delivery through Mailpit
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
MAIL_FROM="Restaurant Admin <no-reply@localhost>"
APP_URL=http://localhost:5174
LANDING_APP_URL=http://localhost:5173

# Chave usada para criptografar (reversível) a senha escolhida pelo lead até a aprovação manual
LEAD_SECRET_KEY="change-me-in-production"

# kitchen-service integration (service-to-service, must match kitchen-service's INTERNAL_API_KEY)
KITCHEN_SERVICE_URL=http://localhost:3000
KITCHEN_SERVICE_INTERNAL_API_KEY="change-me-in-production"

# Chave que valida chamadas internas recebidas do kitchen-service (deve bater com RESTAURANT_ADMIN_INTERNAL_API_KEY de lá)
INTERNAL_API_KEY="change-me-in-production"

# Mercado Pago (mesma conta/token usado pelo kitchen-service para pagamentos de pedidos)
MP_ACCESS_TOKEN="change-me-in-production"
MP_WEBHOOK_BASE_URL=http://localhost:3100
